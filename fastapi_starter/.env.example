# Is file ko copy karke .env banao aur real values daalo.
# .env ko kabhi bhi git me commit mat karna (already .gitignore me hai).

# --- JWT / Auth ---
SECRET_KEY=apna-ek-strong-random-secret-yahan-daalo
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Password reset / email verification token expiry ---
RESET_TOKEN_EXPIRE_MINUTES=30
VERIFY_TOKEN_EXPIRE_HOURS=24

# --- Database ---
# SQLite (default, dev ke liye):
DATABASE_URL=sqlite:///./app.db
# Postgres (production ke liye):
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# --- CORS ---
# Comma separated, apne actual frontend domain(s) daalo. Production me "*" mat use karo.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- HTTPS ---
FORCE_HTTPS=false

# --- Rate limiting ---
LOGIN_RATE_LIMIT=5/minute

# --- SMTP (email bhejne ke liye) ---
# Khaali chhodo to emails console/log me print hongi (dev mode).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_USE_TLS=true

FRONTEND_URL=http://localhost:3000

ENV=development
